import Coercions.Selective.FsubCompare.Measure
/-!
# The chain family `X₀ <: Top → Top, Xᵢ₊₁ <: Xᵢ`  (GENERATED by gen/family.py)

`chainCtx n` has the variables `X₀ … Xₙ` (`Xₙ = var 0`, `X₀ = var n`). The chain
`Xₙ ⇒ … ⇒ X₀ ⇒ Top → Top` has `n+1` bound steps. The universal chain `U₀ ⇒ … ⇒ Uₙ`
with `Uᵢ = ∀(Z <: Xᵢ). Z → Top` has `n` bound changes.
-/
namespace Compare.Fam
open Compare
open SelFsub (Ty Ctx Cert Sub synthC)

abbrev tt : Ty n := .arr .top .top

def chainCtx : (n : Nat) → Ctx (n+1)
  | 0 => .snoc .nil tt
  | n+1 => .snoc (chainCtx n) (.var 0)

/-- Hand-minimal: one `step` per bound, right-nested `;`. -/
def chainCert : (n : Nat) → Cert (n+1)
  | 0 => .step (.var 0) tt
  | n+1 => .seq (.step (.var 0) (.var (Fin.succ 0))) (chainCert n).weaken

/-- `Uᵢ = ∀(Z <: Xᵢ). Z → Top`. -/
def uTy (n i : Nat) : Ty (n+1) := .all (.var (Fin.ofNat (n+1) (n - i))) (.arr (.var 0) .top)

/-- Hand-minimal universal chain: links `i+1 … i+m`, one step each. -/
def uFrom (n i : Nat) : (m : Nat) → Cert (n+1)
  | 0 => .step (uTy n i) (uTy n i)
  | 1 => .step (uTy n i) (uTy n (i+1))
  | m+2 => .seq (.step (uTy n i) (uTy n (i+1))) (uFrom n (i+1) (m+1))
def uCert (n : Nat) : Cert (n+1) := uFrom n 0 n

/-- `d : (Top → Top) → Top → Top ⇒ Top → Top`-style narrowing witness: `U' = Top → (Top → Top)`. -/
def dNarrow : Cert 0 := .step (.arr .top tt) tt
def Ubig : Ty 0 := .arr .top tt

/-- A composite `d : V ⇒ V' ⇒ Top → Top` with `V = Top → Top → Top → Top`. -/
def dInst : Cert 0 :=
  .seq (.step (.arr .top (.arr .top tt)) (.arr .top tt)) (.step (.arr .top tt) tt)
def Vinst : Ty 0 := .arr .top (.arr .top tt)

/-- `X₀ <: U'` for the narrowed family. -/
def chainCtxU : (n : Nat) → Ctx (n+1)
  | 0 => .snoc .nil Ubig
  | n+1 => .snoc (chainCtxU n) (.var 0)

def narrowedCtx : (n : Nat) → Ctx (n+1) := chainCtxU


def chainSub0 : Sub (chainCtx 0) (.var 0) tt := (.bound 0)
def uSub0 : Sub (chainCtx 0) (uTy 0 0) (uTy 0 0) := .refl
def chainSub1 : Sub (chainCtx 1) (.var 0) tt := (.trans (.bound 0) (.bound 1))
def uSub1 : Sub (chainCtx 1) (uTy 1 0) (uTy 1 1) := (.all (.bound 0) .refl)
def chainSub2 : Sub (chainCtx 2) (.var 0) tt := (.trans (.bound 0) (.trans (.bound 1) (.bound 2)))
def uSub2 : Sub (chainCtx 2) (uTy 2 0) (uTy 2 2) := (.trans (.all (.bound 1) .refl) (.all (.bound 0) .refl))
def chainSub3 : Sub (chainCtx 3) (.var 0) tt := (.trans (.bound 0) (.trans (.bound 1) (.trans (.bound 2) (.bound 3))))
