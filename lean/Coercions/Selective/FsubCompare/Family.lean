def chainSub4 : Sub (chainCtx 4) (.var 0) tt := (.trans (.bound 0) (.trans (.bound 1) (.trans (.bound 2) (.trans (.bound 3) (.bound 4)))))
def uSub4 : Sub (chainCtx 4) (uTy 4 0) (uTy 4 4) := (.trans (.all (.bound 3) .refl) (.trans (.all (.bound 2) .refl) (.trans (.all (.bound 1) .refl) (.all (.bound 0) .refl))))
def chainSub5 : Sub (chainCtx 5) (.var 0) tt := (.trans (.bound 0) (.trans (.bound 1) (.trans (.bound 2) (.trans (.bound 3) (.trans (.bound 4) (.bound 5))))))
def uSub5 : Sub (chainCtx 5) (uTy 5 0) (uTy 5 5) := (.trans (.all (.bound 4) .refl) (.trans (.all (.bound 3) .refl) (.trans (.all (.bound 2) .refl) (.trans (.all (.bound 1) .refl) (.all (.bound 0) .refl)))))
def chainSub6 : Sub (chainCtx 6) (.var 0) tt := (.trans (.bound 0) (.trans (.bound 1) (.trans (.bound 2) (.trans (.bound 3) (.trans (.bound 4) (.trans (.bound 5) (.bound 6)))))))
def uSub6 : Sub (chainCtx 6) (uTy 6 0) (uTy 6 6) := (.trans (.all (.bound 5) .refl) (.trans (.all (.bound 4) .refl) (.trans (.all (.bound 3) .refl) (.trans (.all (.bound 2) .refl) (.trans (.all (.bound 1) .refl) (.all (.bound 0) .refl))))))
def chainSub7 : Sub (chainCtx 7) (.var 0) tt := (.trans (.bound 0) (.trans (.bound 1) (.trans (.bound 2) (.trans (.bound 3) (.trans (.bound 4) (.trans (.bound 5) (.trans (.bound 6) (.bound 7))))))))
def uSub7 : Sub (chainCtx 7) (uTy 7 0) (uTy 7 7) := (.trans (.all (.bound 6) .refl) (.trans (.all (.bound 5) .refl) (.trans (.all (.bound 4) .refl) (.trans (.all (.bound 3) .refl) (.trans (.all (.bound 2) .refl) (.trans (.all (.bound 1) .refl) (.all (.bound 0) .refl)))))))
def chainSub8 : Sub (chainCtx 8) (.var 0) tt := (.trans (.bound 0) (.trans (.bound 1) (.trans (.bound 2) (.trans (.bound 3) (.trans (.bound 4) (.trans (.bound 5) (.trans (.bound 6) (.trans (.bound 7) (.bound 8)))))))))
def uSub8 : Sub (chainCtx 8) (uTy 8 0) (uTy 8 8) := (.trans (.all (.bound 7) .refl) (.trans (.all (.bound 6) .refl) (.trans (.all (.bound 5) .refl) (.trans (.all (.bound 4) .refl) (.trans (.all (.bound 3) .refl) (.trans (.all (.bound 2) .refl) (.trans (.all (.bound 1) .refl) (.all (.bound 0) .refl))))))))

